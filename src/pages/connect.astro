---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Get in touch with Nycole Ray — House of Ray. Choreography, dance, education." />
    <meta name="theme-color" content="#FDF8F3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet" />
    <title>Connect | Nycole Ray — House of Ray</title>
    <style>
      .connect-container {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
      }
      .connect-card {
        width: 100%;
        max-width: 420px;
      }
      .monogram {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--purple);
        color: var(--cream);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
        font-family: var(--font-serif);
        font-size: 1.5rem;
        letter-spacing: 0.025em;
      }
      .heading {
        font-family: var(--font-serif);
        font-size: 1.75rem;
        font-weight: 400;
        color: var(--purple);
        text-align: center;
        margin: 0 0 0.25rem;
      }
      .subheading {
        font-family: var(--font-sans);
        font-size: 0.875rem;
        color: var(--purple-light);
        text-align: center;
        margin: 0 0 2rem;
      }
      .form-group {
        margin-bottom: 1rem;
      }
      .form-label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--purple-dark);
        margin-bottom: 0.375rem;
      }
      .form-input {
        width: 100%;
        padding: 0.75rem 1rem;
        background: var(--cream);
        border: 1px solid var(--mauve);
        border-radius: 0.5rem;
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--purple-dark);
        transition: border-color 0.2s, box-shadow 0.2s;
      }
      .form-input::placeholder {
        color: var(--mauve-dark);
      }
      .form-input:focus {
        outline: none;
        border-color: var(--purple);
        box-shadow: 0 0 0 3px rgba(93, 78, 109, 0.15);
      }
      textarea.form-input {
        resize: vertical;
        min-height: 100px;
      }
      .submit-btn {
        width: 100%;
        padding: 0.875rem 1.5rem;
        background: var(--gold);
        color: var(--purple-dark);
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        font-weight: 600;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 0.5rem;
      }
      .submit-btn:hover {
        background: var(--gold-light);
      }
      .submit-btn:disabled {
        background: var(--mauve);
        cursor: not-allowed;
      }
      .submit-btn .spinner {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .submit-btn .spinner svg {
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      .divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 1.75rem 0;
        color: var(--mauve-dark);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .divider::before,
      .divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--mauve-light);
      }
      .email-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        padding: 0.875rem 1.25rem;
        border: 1px solid var(--mauve-light);
        border-radius: 0.5rem;
        text-decoration: none;
        color: var(--purple-dark);
        font-size: 0.9375rem;
        transition: border-color 0.2s, background 0.2s;
      }
      .email-link:hover {
        border-color: var(--purple);
        background: rgba(229, 212, 210, 0.3);
      }
      .email-link svg {
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        color: var(--purple-light);
      }
      .success-card {
        text-align: center;
        padding: 2rem 1rem;
      }
      .success-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--gold);
        color: var(--purple-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
      }
      .success-icon svg {
        width: 28px;
        height: 28px;
      }
      .success-title {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        color: var(--purple);
        margin: 0 0 0.5rem;
      }
      .success-text {
        font-size: 0.9375rem;
        color: var(--purple-light);
        margin: 0;
      }
    </style>
  </head>
  <body class="bg-cream text-purple-dark antialiased">
    <div class="connect-container">
      <div class="connect-card">
        <!-- Header -->
        <div class="monogram">NR</div>
        <h1 class="heading">Get in Touch</h1>
        <p class="subheading">I'd love to hear from you.</p>

        <!-- Success message (hidden by default) -->
        <div id="success" class="success-card" style="display:none;">
          <div class="success-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
          </div>
          <h2 class="success-title">Message Sent</h2>
          <p class="success-text">Thank you — I'll be in touch soon.</p>
        </div>

        <!-- Form -->
        <form id="connect-form" action="https://formspree.io/f/xnjzlwld" method="POST">
          <div class="form-group">
            <label for="name" class="form-label">Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" class="form-input" />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="form-input" />
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" rows="4" required class="form-input" placeholder="Tell me about your project or event..."></textarea>
          </div>

          <button type="submit" class="submit-btn">Send Message</button>
        </form>

        <!-- Or email directly -->
        <div class="divider">or email directly</div>

        <a href="mailto:houseofray.art@gmail.com" class="email-link">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          houseofray.art@gmail.com
        </a>
      </div>
    </div>
  </body>
</html>

<script>
  const form = document.getElementById('connect-form') as HTMLFormElement;
  const success = document.getElementById('success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const original = btn.textContent;
    btn.disabled = true;
    btn.innerHTML = `<span class="spinner"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity="0.25"/><path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>Sending...</span>`;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        form.style.display = 'none';
        success!.style.display = 'block';
      } else {
        throw new Error();
      }
    } catch {
      btn.disabled = false;
      btn.textContent = original;
      alert('Something went wrong. Please try again or email directly.');
    }
  });
</script>
