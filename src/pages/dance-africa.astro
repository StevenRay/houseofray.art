---
import Seo from '../components/Seo.astro';
import { danceAfricaPageSchema } from '../lib/page-schema';
import { photos, cover } from '../data/dance-africa';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><Seo title="DanceAfrica 2026 — Nycole Ray, Mistress of Ceremonies | House of Ray" description="Nycole Ray served as Mistress of Ceremonies for DanceAfrica 2026, presented by Dallas Black Dance Theatre at Moody Performance Hall. Photographs from the Dallas celebration." breadcrumb="Dance Africa" image="/social/dance-africa-v1.png" imageAlt="Dance Africa — dancers in orange costumes perform under stage lights. A weekend in movement." schema={danceAfricaPageSchema()} /><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/subpages.css"><script src="/subpages.js" defer></script><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta name="theme-color" content="#2e153f"><link rel="stylesheet" href="/dance-africa.css"><script src="/dance-africa.js" defer></script></head><body class="subpage dance-africa-page" id="top"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/" aria-label="House of Ray home">HOUSE<br>OF RAY.</a><nav class="full-nav" aria-label="Main navigation"><a href="/about/">About</a><a href="/work/">Work</a><a href="/video/">Video</a><a href="/teaching/">Teaching</a><a href="/press/">Press</a><a class="event-nav" href="/dance-africa/" aria-current="page">Dance Africa</a><a href="/contact/">Contact</a></nav><details class="nav-menu"><summary>Menu <span>+</span></summary><nav aria-label="Mobile navigation"><a href="/about/">About</a><a href="/work/">Work</a><a href="/video/">Video</a><a href="/teaching/">Teaching</a><a href="/press/">Press</a><a class="event-nav" href="/dance-africa/" aria-current="page">Dance Africa</a><a href="/contact/">Contact</a></nav></details></header><main id="main"><div class="event-hero-grid"><section class="event-opening"><p class="eyebrow">HOUSE OF RAY / RECENT EVENT</p><h1>DANCE<br/>AFRICA<span>.</span></h1><div class="event-opening-bottom"><p>Nycole Ray, Mistress of Ceremonies.</p>{photos.length > 0 && <a href="#photographs">Explore the photographs <span aria-hidden="true">↓</span></a>}</div></section>
{photos.length > 0 && <figure class="event-cover"><img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} fetchpriority="high" />{(cover.caption || cover.credit) && <figcaption>{cover.caption}{cover.credit && <span>Photography: {cover.credit}</span>}</figcaption>}</figure>}</div>
<section class="event-story" aria-labelledby="event-story-title">
  <div><p class="eyebrow">OCTOBER 9–10, 2026 · DALLAS</p><h2 id="event-story-title">A celebration of culture.<br/>A weekend in movement.</h2></div>
  <div class="event-story-copy"><p>Nycole Ray served as Mistress of Ceremonies for DanceAfrica 2026, presented by Dallas Black Dance Theatre at Moody Performance Hall.</p><p>The celebration brought together traditional and contemporary African dance with live drumming, featuring Dallas Black Dance Theatre, DBDT: Encore, Dallas Black Dance Academy’s performing ensembles, and guest artists including African drum and dance ensemble Bandan Koro.</p><a class="line-link" href="https://attpac.org/event/danceafrica-2026" target="_blank" rel="noopener noreferrer">About the event <span aria-hidden="true">↗</span></a></div>
</section>
{photos.length > 0 && <section class="event-photographs" id="photographs" aria-label="Dance Africa photographs"><div class="collection-heading"><h2>In the moment.</h2><span>{photos.length} PHOTOGRAPHS</span></div><div class="event-photo-grid">{photos.map((photo,index)=><figure><button type="button" data-photo-index={index} data-src={photo.src} data-alt={photo.alt} data-caption={[photo.caption,photo.credit ? `Photography: ${photo.credit}` : ''].filter(Boolean).join(' — ')} aria-label={`Enlarge photograph ${index+1}: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy"/><span aria-hidden="true">↗</span></button>{(photo.caption || photo.credit) && <figcaption>{photo.caption}{photo.credit && <span>Photography: {photo.credit}</span>}</figcaption>}</figure>)}</div></section>}
<dialog class="event-lightbox" aria-label="Dance Africa photo viewer"><button type="button" class="event-close" aria-label="Close photograph">×</button><div class="event-lightbox-frame"><img alt=""/></div><div class="event-lightbox-controls"><button type="button" data-previous aria-label="Previous photograph">←</button><p aria-live="polite"></p><button type="button" data-next aria-label="Next photograph">→</button></div><p class="event-lightbox-caption"></p></dialog></main><section class="sub-contact"><p class="eyebrow">CHOREOGRAPHY · RESIDENCIES · MASTER CLASSES · SPEAKING</p><a href="/contact/">Let’s create.<span>↗</span></a></section><footer class="sub-footer"><a class="brand" href="/">HOUSE<br>OF RAY.</a><p>Choreographer · Dancer · Educator<br>© 2026 Nycole Ray.</p><div><a href="/video/">Video</a><a href="#top">Back to top ↑</a></div></footer></body></html>