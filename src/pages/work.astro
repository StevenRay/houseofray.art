<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><Seo title="Choreography by Nycole Ray — Repertory | House of Ray" description="Eleven works by Dallas choreographer Nycole Ray, commissioned by Texas Ballet Theater, Dallas Black Dance Theatre, The Dallas Opera, and Dallas Museum of Art, including a tribute to Bruce Wood." breadcrumb="Repertory" schema={workPageSchema()} /><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/subpages.css"><script src="/subpages.js" defer></script><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta name="theme-color" content="#2e153f"><link rel="stylesheet" href="/dance-africa.css"></head><body class="subpage work-page" id="top"><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/" aria-label="House of Ray home">HOUSE<br>OF RAY.</a><nav class="full-nav" aria-label="Main navigation"><a href="/about/">About</a><a href="/work/" aria-current="page">Work</a><a href="/video/">Video</a><a href="/teaching/">Teaching</a><a href="/press/">Press</a><a class="event-nav" href="/dance-africa/">Dance Africa</a><a href="/contact/">Contact</a></nav><details class="nav-menu"><summary>Menu <span>+</span></summary><nav aria-label="Mobile navigation"><a href="/about/">About</a><a href="/work/" aria-current="page">Work</a><a href="/video/">Video</a><a href="/teaching/">Teaching</a><a href="/press/">Press</a><a class="event-nav" href="/dance-africa/">Dance Africa</a><a href="/contact/">Contact</a></nav></details></header><main id="main"><section class="page-hero"><div><p class="eyebrow">HOUSE OF RAY / NYCOLE RAY</p><h1>Repertory<span>.</span></h1><p class="page-description">Selected choreographic works.</p></div><span class="hero-index" aria-hidden="true">HOUSE<br>OF RAY</span></section><section class="page-section"><div class="collection-heading"><p class="eyebrow">CHOREOGRAPHY / SELECTED WORK</p><span>11 WORKS</span></div><div class="repertory-list"><details id="international-woman" class="repertory-item" open><summary><span class="item-number">01</span><h2>International Woman</h2><span class="item-year">2025</span><span class="expand">+</span></summary><div class="repertory-detail"><dl><div><dt>Music</dt><dd>Henryk Górecki</dd></div><div><dt>Commission</dt><dd>Texas Ballet Theater</dd></div><div><dt>Premiere</dt><dd>Bass Performance Hall; Fort Worth, TX; 2025</dd></div></dl></div></details><details id="diaspora" class="repertory-item"><summary><span class="item-number">02</span><h2>Diaspora</h2><span class="item-year">2022</span><span class="expand">+</span></summary><div class="repertory-detail"><dl><div><dt>Commission</dt><dd>Dallas Black Dance Theatre</dd></div><div><dt>Premiere</dt><dd>New Texas Symphony Orchestra at Moody Performance Hall; Dallas, TX; 2022</dd></div></dl></div></details><article class="repertory-item repertory-simple"><span class="item-number">03</span><h2>Rising</h2><a href="/contact/?subject=Rising" aria-label="Inquire about Rising">Inquire ↗</a></article><details id="nineteenth" class="repertory-item"><summary><span class="item-number">04</span><h2>Nineteenth</h2><span class="item-year">2021</span><span class="expand">+</span></summary><div class="repertory-detail"><dl><div><dt>Premiere</dt><dd>Virtual premiere; 2021</dd></div></dl><p>Created for the centennial of the 19th Amendment</p></div></details><article class="repertory-item repertory-simple"><span class="item-number">05</span><h2>Love Songs</h2><a href="/contact/?subject=Love%20Songs" aria-label="Inquire about Love Songs">Inquire ↗</a></article><article class="repertory-item repertory-simple"><span class="item-number">06</span><h2>The Breath Within</h2><a href="/contact/?subject=The%20Breath%20Within" aria-label="Inquire about The Breath Within">Inquire ↗</a></article><article class="repertory-item repertory-simple"><span class="item-number">07</span><h2>Opaque</h2><a href="/contact/?subject=Opaque" aria-label="Inquire about Opaque">Inquire ↗</a></article><details id="above--amp--below" class="repertory-item"><summary><span class="item-number">08</span><h2>Above &amp; Below</h2><span class="item-year"></span><span class="expand">+</span></summary><div class="repertory-detail"><dl></dl><p>Created in tribute to Bruce Wood</p><a class="line-link" href="/video/">View performance video ↗</a></div></details><details id="reminisce" class="repertory-item"><summary><span class="item-number">09</span><h2>Reminisce</h2><span class="item-year">2020</span><span class="expand">+</span></summary><div class="repertory-detail"><dl><div><dt>Music</dt><dd>John Legend and various artists</dd></div><div><dt>Commission</dt><dd>Dallas Black Dance Theatre</dd></div><div><dt>Premiere</dt><dd>Eisemann Center; Richardson, TX; 2020</dd></div></dl></div></details><details id="samson-and-delilah" class="repertory-item"><summary><span class="item-number">10</span><h2>Samson and Delilah</h2><span class="item-year"></span><span class="expand">+</span></summary><div class="repertory-detail"><dl><div><dt>Commission</dt><dd>The Dallas Opera</dd></div></dl><p>Opera choreography</p></div></details><details id="frida--frida-and-frida" class="repertory-item"><summary><span class="item-number">11</span><h2>Frida, Frida and Frida</h2><span class="item-year"></span><span class="expand">+</span></summary><div class="repertory-detail"><dl><div><dt>Commission</dt><dd>Dallas Museum of Art</dd></div></dl></div></details></div></section><section class="editorial-band"><p class="eyebrow">FROM THE STUDIO TO THE STAGE</p><h2>See the work<br>in <em>motion.</em></h2><a class="line-link" href="/video/">Performance documentat