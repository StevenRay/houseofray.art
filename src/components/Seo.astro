---
import { SITE_NAME, absoluteUrl, canonicalUrl } from '../data/site';
import { breadcrumbNode, organizationNode, personNode, webSiteNode } from '../lib/schema';

interface Props {
  /** Full contents of the <title> tag and the og:title / twitter:title. */
  title: string;
  description: string;
  /** Must be a 1200x630 PNG social card — those dimensions are declared below. */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Keeps thin utility pages (QR card, standalone form) out of the index. */
  noindex?: boolean;
  /** Breadcrumb label for the second crumb. Omit on the home page. */
  breadcrumb?: string;
  /** Page-specific JSON-LD nodes, merged into the site-wide @graph. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = '/social/house-of-ray-v1.png',
  imageAlt = 'House of Ray — Nycole Ray, dancer, choreographer and educator, in purple and ivory couture.',
  ogType = 'website',
  noindex = false,
  breadcrumb,
  schema = [],
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(image);

const graph = noindex
  ? []
  : [
      webSiteNode(),
      organizationNode(),
      personNode(),
      ...(breadcrumb ? [breadcrumbNode(canonical, breadcrumb)] : []),
      ...schema,
    ];

// Escaping `<` keeps a stray "</script>" inside any string from closing the tag early.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  )
}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{graph.length > 0 && <script type="application/ld+json" is:inline set:html={jsonLd} />}
