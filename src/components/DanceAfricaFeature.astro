---
import { photos } from '../data/dance-africa';
const cover = photos[0];
---
<section id="dance-africa" class:list={["event-feature", { "has-photo": cover }]} aria-labelledby="event-feature-title">
  {cover && <a class="event-feature-photo" href="/dance-africa/" aria-label="View Dance Africa photographs"><img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" /></a>}
  <div class="event-feature-copy"><p class="eyebrow"><span class="event-dot" aria-hidden="true"></span>RECENT PERFORMANCE</p><h2 id="event-feature-title">DANCE<br/>AFRICA<span>.</span></h2><p class="event-deck">A weekend in movement.</p><a class="line-link" href="/dance-africa/">Explore the photographs <span aria-hidden="true">↗</span></a></div>
</section>
